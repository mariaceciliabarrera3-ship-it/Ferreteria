# FerreGest AR — ejemplo de variables de entorno (ARQ-04 / ETAPA 4)
#
# Este archivo se versiona a propósito: documenta QUÉ variables existen.
# Nunca debe contener valores reales. Copiarlo como `.env` y completarlo;
# `.env` está excluido del repositorio por .gitignore.
#
# Variables marcadas como OBLIGATORIAS son las que definen el comportamiento
# seguro de la instalación.

# ---------------------------------------------------------------- modo (ARQ-04)
# demo       -> permite operar sin licencia, con aviso permanente (por defecto)
# production -> exige licencia válida: sin licencia NO se puede vender, comprar,
#               mover stock ni operar caja (fail-safe). Lectura y copias: sí.
FERREGEST_MODE=demo

# ------------------------------------------------------------- base de datos
# Ruta del archivo SQLite de la instalación. Debe estar en una carpeta local,
# persistente y con copias de seguridad (no en una carpeta sincronizada).
FERREGEST_DB=/ruta/absoluta/a/ferregest.db

# ------------------------------------------------------------------ secretos
# Clave de firma de cookies de sesión. Si no se define, la aplicación genera una
# en .secret (0600). En producción conviene fijarla y respaldarla.
FERREGEST_SECRET=

# Clave de firma/verificación de licencias (HMAC-SHA256). Pertenece al entorno
# privado de quien emite las licencias. NUNCA se sube a GitHub.
# LICENSE_SIGNING_KEY=

# Contraseña del usuario `admin` que se crea en el primer arranque. Si no se
# define: en modo demo se usa `admin123` (con aviso); en producción se genera
# una aleatoria y se guarda en var/claves_inicial_admin.txt.
FERREGEST_ADMIN_PASSWORD=

# --------------------------------------------------------------- sesión y red
# 1 si la aplicación se sirve por HTTPS (habilita la cookie Secure).
SESSION_COOKIE_SECURE=0
# Host de escucha del servidor local (por defecto 127.0.0.1: no se expone en LAN).
FERREGEST_HOST=127.0.0.1
# Puerto del servidor local.
PORT=8000
# Horas de duración de la sesión (por defecto 8).
FERREGEST_SESSION_HOURS=8
# 1 para modo debug de Flask (NUNCA en producción).
FERREGEST_DEBUG=0

# ------------------------------------------------- límite de intentos (ARQ-08)
FERREGEST_LOGIN_MAX_ATTEMPTS=8
FERREGEST_LOGIN_WINDOW_MINUTES=60
FERREGEST_LOGIN_LOCKOUT_MINUTES=15

# --------------------------------------------------- SQLite y concurrencia
# Milisegundos de espera cuando otro proceso está escribiendo (ARQ-12).
FERREGEST_BUSY_TIMEOUT_MS=8000

# ----------------------------------------------------- only para seed_demo.py
# FERREGEST_MODE=demo es obligatorio. Además: --confirmar-demo o
# FERREGEST_SEED_DEMO=1, y claves por variables (si faltan, se generan).
# FERREGEST_SEED_DEMO=1
# FERREGEST_DEMO_ADMIN_PASSWORD=
# FERREGEST_DEMO_VENDOR_PASSWORD=
# FERREGEST_DEMO_STOCK_PASSWORD=
